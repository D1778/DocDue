# ========================================
# DocDue — Environment Variables Template
# ========================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.

# --- Database (MongoDB Atlas Free Tier) ---
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/docdue_db?retryWrites=true&w=majority
DATABASE_NAME=docdue_db

# --- JWT Auth ---
SECRET_KEY=your-super-secret-jwt-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=docdue-documents

# --- Tesseract OCR ---
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- SMTP Email (Gmail or Resend) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# --- App Settings ---
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
