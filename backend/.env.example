# ========================================
# DocDue - Environment Variables Template
# ========================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.

# --- Database (MongoDB Atlas) ---
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=docdue

# --- JWT Auth ---
SECRET_KEY=generate-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AWS S3 (used from Sprint 2) ---
# --- AWS S3 (Sprint 2) ---
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# Only needed for the university Learner Lab (temporary credentials). Otherwise leave empty.
AWS_SESSION_TOKEN=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=your-unique-bucket-name
# Only needed for non-AWS providers such as Backblaze B2. Otherwise leave empty.
S3_ENDPOINT_URL=
# How long upload and view links stay valid, in seconds
PRESIGNED_URL_EXPIRE_SECONDS=300
# Largest file a user may upload, in megabytes
MAX_UPLOAD_SIZE_MB=10

# --- Tesseract OCR (used from Sprint 3) ---
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- SMTP Email (used from Sprint 4) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# --- App Settings ---
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000