# ========================================
# DocDue - Environment Variables Template
# ========================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.

# --- Database (MongoDB Atlas) ---
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=docdue

# --- JWT Auth ---
SECRET_KEY=generate-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AWS S3 (used from Sprint 2) ---
# --- AWS S3 (Sprint 2) ---
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# Only needed for the university Learner Lab (temporary credentials). Otherwise leave empty.
AWS_SESSION_TOKEN=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=your-unique-bucket-name
# Only needed for non-AWS providers such as Backblaze B2. Otherwise leave empty.
S3_ENDPOINT_URL=
# How long upload and view links stay valid, in seconds
PRESIGNED_URL_EXPIRE_SECONDS=300
# Largest file a user may upload, in megabytes
MAX_UPLOAD_SIZE_MB=10

# --- Tesseract OCR (used from Sprint 3) ---
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- SMTP Email (used from Sprint 4) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# --- App Settings ---
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000

# --- OCR (Sprint 3) ---
# Full path to tesseract.exe. Use forward slashes. Leave empty if tesseract is on your PATH.
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# Languages to read. "eng" is English. Add more with + (for example eng+hin)
OCR_LANG=eng
# A document with this many days or fewer left is "expiring"
EXPIRING_SOON_DAYS=30

# --- Email (Sprint 4) ---
# console = print emails in the terminal (development). smtp = really send them.
EMAIL_MODE=console
EMAIL_FROM="DocDue <no-reply@example.com>"
# Only needed when EMAIL_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Daily job (Sprint 4) ---
SCHEDULER_ENABLED=true
# 03:00 UTC is 08:30 in India
DAILY_JOB_HOUR_UTC=3
DAILY_JOB_MINUTE_UTC=0
# Days before expiry at which a reminder goes out. 0 = the expiry day and after.
REMINDER_DAYS=30,14,7,1,0
# Unfinished uploads older than this many hours are deleted
ORPHAN_AFTER_HOURS=24
# Documents stuck on "processing" longer than this many minutes are read again
STUCK_PROCESSING_MINUTES=10