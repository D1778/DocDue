# ========================================
# DocDue Frontend — Environment Variables
# ========================================

# Where the FastAPI backend lives. Must end with /api/v1 (no trailing slash needed).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Google "Client ID" for the Sign in with Google button. Same value as GOOGLE_CLIENT_ID in the
# backend .env. It is public by design (not a secret). Leave empty and the button explains it is off.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Largest file the upload page accepts, in MB. Keep it equal to MAX_UPLOAD_SIZE_MB in the backend.
NEXT_PUBLIC_MAX_UPLOAD_MB=10