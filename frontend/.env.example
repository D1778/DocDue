# ========================================
# DocDue Frontend — Environment Variables
# ========================================

# Where the FastAPI backend lives. Must end with /api/v1 (no trailing slash needed).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Largest file the upload page accepts, in MB. Keep it equal to MAX_UPLOAD_SIZE_MB in the backend.
NEXT_PUBLIC_MAX_UPLOAD_MB=10