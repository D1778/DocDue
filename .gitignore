# =====================================
# DocDue — .gitignore
# =====================================

# --- Environment files (NEVER commit secrets) ---
.env
.env.local
.env.*.local
backend/.env
frontend/.env
frontend/.env.local
frontend/.env*.local

# --- Python / Backend ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
backend/.venv/
.pytest_cache/
*.sqlite3
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg

# --- Node.js / Frontend ---
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
.npm/
.eslintcache

# --- Testing & Coverage ---
coverage/
.coverage
htmlcov/
*.lcov

# --- Secrets & Keys ---
*.pem
*.key
*.p12
*.pfx

# --- OS Files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editor ---
.vscode/settings.json
*.suo
*.user
*.swp
*.swo
*~

# --- Build artifacts ---
/build
*.tsbuildinfo
next-env.d.ts

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Vercel / Deployment ---
.vercel