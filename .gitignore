# =====================================
# DocDue — .gitignore
# =====================================
# --- Environment files (NEVER commit these) ---
.env
.env.local
.env.*.local
backend/.env
frontend/.env
frontend/.env.local
# --- Python / Backend ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
*.sqlite3
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg
# --- Alembic (keep structure, ignore local cache) ---
# alembic/versions/ is committed on purpose
# --- Node.js / Frontend ---
node_modules/
.next/
out/
.npm/
.eslintcache
# --- Testing & Coverage ---
coverage/
.coverage
htmlcov/
*.lcov
# --- Secrets & Keys ---
*.pem

*.key
*.p12
*.pfx
# --- OS Files ---
.DS_Store
Thumbs.db
desktop.ini
# --- Editor ---
.vscode/settings.json
*.suo
*.user
*.swp
*.swo
*~
# --- Build artifacts ---
/build
*.tsbuildinfo
next-env.d.ts
# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# --- Vercel / Deployment ---
.vercel

PRO_DESX.docx
Stage_0_*
CLAUDE.md